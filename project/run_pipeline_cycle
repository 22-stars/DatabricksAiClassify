import os

_project_root = os.environ.get(
    "PROJECT_ROOT",
    "/Repos/debashish8101@gmail.com/databricks-ai-classify/project"
)
if _project_root not in sys.path:
    sys.path.insert(0, _project_root)

from datetime import datetime
from src.detection.failure_detector import detect_new_failures
from src.classification.ai_classifier import classify_error
from src.tracking.tracker import (
    insert_new_failure,
    update_classification,
    get_rows_by_status,
    mark_as_retried,
    mark_as_resolved,
    mark_as_max_retries_reached,
)
from src.utils.databricks_client import get_workspace_client
from src.webhook_handler import (
    handle_failure_notification,
    process_due_retries,
    check_retry_outcomes,
)
from pyspark.sql import SparkSession

spark = SparkSession.builder.getOrCreate()

# Check if invoked with parameters (webhook mode)
try:
    _job_id = dbutils.widgets.get("job_id")
    _run_id = dbutils.widgets.get("run_id")
    _error_message = dbutils.widgets.get("error_message")
except Exception:
    _job_id = _run_id = _error_message = None

if _job_id and _run_id and _error_message:
    # WEBHOOK MODE: Process specific failure immediately
    print("=== Webhook Mode: Processing Job Failure ===")
    print(f"  Job ID: {_job_id}")
    print(f"  Run ID: {_run_id}")
    print("---")

    handle_failure_notification(
        job_id=_job_id,
        run_id=_run_id,
        error_message=_error_message,
    )

    process_due_retries()
    check_retry_outcomes()

else:
    # PERIODIC MODE: Full scan + retry + outcome check
    print("=== Periodic Mode: Full Pipeline Cycle ===")
    print("---")

    # Step 1: Detect new failures (same as webhook handler does)
    new_failures = detect_new_failures()
    print(f"Detected {len(new_failures)} new failure(s)")

    for failure in new_failures:
        tracking_id = insert_new_failure(
            job_id=failure["job_id"],
            run_id=failure["run_id"],
            error_message=failure["error_message"],
            first_failed_at=datetime.utcnow(),
        )

        result = classify_error(failure["error_message"], spark)
        classification = result["classification"]

        if classification == "Transient":
            new_status = "retry_scheduled"
        elif classification == "Permanent":
            new_status = "permanent_no_action"
        else:
            new_status = "unknown_flagged"

        update_classification(tracking_id, classification, new_status)
        print(f"  - job_id={failure['job_id']} run_id={failure['run_id']} -> {classification} -> {new_status}")

    # Step 2: Process retries that are due
    process_due_retries()

    # Step 3: Check retry outcomes
    check_retry_outcomes()

print("=== Cycle complete ===")
